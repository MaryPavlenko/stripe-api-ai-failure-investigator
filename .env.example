# Only use Stripe TEST MODE. Never commit real keys.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SANDBOX_KEY

# Take this from the output of `stripe listen --forward-to localhost:4242/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_CLI_SIGNING_SECRET
DATABASE_URL=postgresql://lab:YOUR_LOCAL_PASSWORD@127.0.0.1:5433/payment_lab
PORT=4242

# Local PostgreSQL configuration
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD