{
  "name": "stripe-api-ai-failure-investigator",
  "version": "0.1.0",
  "private": true,
  "description": "Explore and test Stripe payment APIs and investigate integration failures with AI",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=local",
    "test:sandbox": "playwright test --project=stripe-sandbox",
    "test:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "openai": "^7.57.0",
    "pg": "^8.16.0",
    "stripe": "^20.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
